<?xml version="1.0" encoding="utf-8"?>
<!-- Unity 공식 분석기(Microsoft.Unity.Analyzers) 규칙 심각도. 기본이 Info 인 규칙을 Warning 으로 올려 컴파일 때 보이게 한다.
     성능 · 정확성 · 타입 안전 규칙 전부. 제외: UNT0005(은퇴) · UNT0021(선택 규칙) · UNT0034/0035(가독성).
     prereq.py install unity-analyzers 가 Assets/Default.ruleset 이 없을 때만 복사한다 (있으면 프로젝트 것을 존중).
     규칙 목록: https://github.com/microsoft/Microsoft.Unity.Analyzers/blob/main/doc/index.md -->
<RuleSet Name="Unity analyzers (template)" ToolsVersion="16.0">
