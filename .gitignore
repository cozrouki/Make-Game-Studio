# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Backup directories
.claude.backup-*
*.bak

# Local-only settings (per-machine — should be created by each user)
.claude/settings.local.json

# Machine-specific MCP config — copy .mcp.json.template → .mcp.json and edit paths
.mcp.json

# Runtime state / locks (created at runtime by hooks & scheduler)
.claude/scheduled_tasks.lock
production/stage.txt

# Operational data (created at runtime by hooks)
production/session-logs/
production/session-state/active.md
*.log

# Project-specific design docs (do NOT ship in the reusable template)
# EA_TechSpec 등은 원본 프로젝트 전용. 자기 프로젝트 spec 은 자유롭게 추가하되
# 이 템플릿 저장소에는 커밋하지 않는 것을 권장.
production/spec/

# artgen — 생성 원본·교체 백업은 용량이 커서 제외 (state.json · review.md · import-map.json 은 추적)
production/artgen/*/v*/
production/artgen/*/replaced/
.agent/tools/artgen/artgen.config.local.json
# studio — 세션 이벤트 로그(로컬 감사용) · 로컬 설정
production/studio/events.jsonl
.agent/tools/studio/studio.config.local.json
__pycache__/

# Build artifacts
dist/
build/
node_modules/
